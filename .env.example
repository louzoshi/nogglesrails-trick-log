# Public URL of the deployment (used in mini app manifest + embeds)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Base RPC (defaults to the public endpoint)
NEXT_PUBLIC_BASE_RPC_URL=

# Pinata JWT — server only, signs one-off upload URLs
PINATA_JWT=

# Optional: gateway for clip URLs. Must be a host gnars.com renders inline
# (ipfs.skatehive.app, gateway.pinata.cloud, *.mypinata.cloud, ipfs.io, dweb.link…)
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.skatehive.app/ipfs/


# Farcaster account association (sign at https://farcaster.xyz/~/developers/mini-apps/manifest)
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=

# Demo mode: sample data + simulated log flow, with a visible banner
NEXT_PUBLIC_DEMO_MODE=0
